# Makefile.sim — Verilog simulation targets
.PHONY: sim-all sim-puf sim-fuzzy-extract sim-boot-keygen sim-frame-hasher sim-sha512 sim-fe25519 sim-ed25519-point sim-ed25519-sign clean

IVERILOG = iverilog
VVP = vvp
SIM_FLAGS = -DSIMULATION -g2012

SHA512_SRC = rtl/sha512/sha512_core.v \
             rtl/sha512/sha512_k_constants.v \
             rtl/sha512/sha512_h_constants.v \
             rtl/sha512/sha512_w_mem.v

ED25519_SRC = rtl/ed25519/fe25519.v \
              rtl/ed25519/ed25519_point.v \
              rtl/ed25519/ed25519_scalarmult.v

sim-all: sim-puf sim-fuzzy-extract sim-sha512 sim-fe25519 sim-ed25519-point sim-boot-keygen sim-frame-hasher

sim-puf:
	@echo "=== Simulating PUF ==="
	$(IVERILOG) $(SIM_FLAGS) -o output/puf.vvp rtl/puf.v sim/tb_puf.v
	$(VVP) output/puf.vvp

sim-fuzzy-extract:
	@echo "=== Simulating Fuzzy Extractor ==="
	$(IVERILOG) $(SIM_FLAGS) -o output/fuzzy_extract.vvp rtl/puf.v rtl/fuzzy_extract.v sim/tb_fuzzy_extract.v
	$(VVP) output/fuzzy_extract.vvp

sim-boot-keygen:
	@echo "=== Simulating Boot Keygen ==="
	$(IVERILOG) $(SIM_FLAGS) -o output/boot_keygen.vvp \
		rtl/puf.v rtl/fuzzy_extract.v \
		$(SHA512_SRC) $(ED25519_SRC) \
		rtl/boot_keygen.v sim/tb_boot_keygen.v
	$(VVP) output/boot_keygen.vvp

sim-frame-hasher:
	@echo "=== Simulating Frame Hasher ==="
	$(IVERILOG) $(SIM_FLAGS) -o output/frame_hasher.vvp \
		$(SHA512_SRC) rtl/frame_hasher.v sim/tb_frame_hasher.v
	$(VVP) output/frame_hasher.vvp

sim-sha512:
	@echo "=== Simulating SHA-512 ==="
	$(IVERILOG) $(SIM_FLAGS) -o output/sha512.vvp $(SHA512_SRC) sim/tb_sha512.v
	$(VVP) output/sha512.vvp

sim-fe25519:
	@echo "=== Simulating FE25519 ==="
	$(IVERILOG) $(SIM_FLAGS) -o output/fe25519.vvp rtl/ed25519/fe25519.v sim/tb_fe25519.v
	$(VVP) output/fe25519.vvp

sim-ed25519-point:
	@echo "=== Simulating Ed25519 Point Ops ==="
	$(IVERILOG) $(SIM_FLAGS) -o output/ed25519_point.vvp $(ED25519_SRC) sim/tb_ed25519_point.v
	$(VVP) output/ed25519_point.vvp

sim-ed25519-sign:
	@echo "=== Simulating Ed25519 Signing ==="
	$(IVERILOG) $(SIM_FLAGS) -o output/ed25519_sign.vvp $(SHA512_SRC) $(ED25519_SRC) rtl/ed25519/ed25519_sign.v sim/tb_ed25519_sign.v
	$(VVP) output/ed25519_sign.vvp

clean:
	rm -f output/*.vvp output/*.vcd
